Options -Indexes
RewriteEngine On
RewriteBase /it_asset_inventory/

# Redirect /page.php to /page
RewriteCond %{THE_REQUEST} \s/it_asset_inventory/([^\s?]+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Allow existing files and folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Load .php file when URL has no extension
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Default page
DirectoryIndex index.php index.html
